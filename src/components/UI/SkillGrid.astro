---
import { Image } from "astro:assets";

type Props = {
    stack: {
        name: string;
        icon: ImageMetadata;
        link: string;
    }[];
};

const { stack }: Props = Astro.props;
---

<div class="Fade_Up flex flex-wrap justify-center gap-4">
    {
        stack.map((obj) => (
            <a
                href={obj.link}
                title={obj.name}
                class="Fade_Stagger flex_center flex-col gap-2 w-28 h-28 rounded-lg bg-skillGradient transition-transform hover:scale-105"
                target="_blank"
                rel="noreferrer"
            >
                <div class="flex_center w-[40px] h-[40px]">
                    <Image
                        src={obj.icon}
                        alt={obj.name.replaceAll(" ", "_") + "_Icon"}
                        width={40}
                        height={40}
                        class="w-full h-full object-contain"
                    />
                </div>
                <span class="text-[0.85em] text-center px-1 leading-tight">{obj.name}</span>
            </a>
        ))
    }
</div>

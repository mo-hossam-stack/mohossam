---
import { CenterTitle, SkillTitle, SkillGrid } from "./UI";
import {
    FrontendStack,
    BackendStack,
    ProgrammingStack,
    ToolsStack,
} from "../utils/SkillStack";
---

<section id="skills" class="w-full min-h-screen px-6 py-16 pt-14 bg-background relative">
    <!-- Background decoration -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-1/3 -left-64 w-[500px] h-[500px] bg-[var(--primaryColor)] opacity-[0.03] rounded-full blur-[150px]"></div>
        <div class="absolute bottom-1/3 -right-64 w-[500px] h-[500px] bg-[var(--secondaryColor)] opacity-[0.03] rounded-full blur-[150px]"></div>
    </div>

    <CenterTitle title="Tech Stack" color="primary" />

    <div class="Fade_Up grid grid-cols-1 lg:grid-cols-2 gap-6 w-full relative z-10">
        <!-- Front-End -->
        <div class="Fade_Up flex_center flex-col gap-4 py-6 px-6 w-full h-full min-h-[280px] rounded-2xl bg-[var(--cardGlass)] border border-[var(--borderColor)] backdrop-blur-sm hover:border-[var(--borderHover)] transition-all duration-300">
            <SkillTitle title="Front-End" color="primary" />
            <SkillGrid stack={FrontendStack} />
        </div>

        <!-- Back-End -->
        <div class="Fade_Up flex_center flex-col gap-4 py-6 px-6 w-full h-full min-h-[280px] rounded-2xl bg-[var(--cardGlass)] border border-[var(--borderColor)] backdrop-blur-sm hover:border-[var(--borderHover)] transition-all duration-300">
            <SkillTitle title="Back-End" color="primary" />
            <SkillGrid stack={BackendStack} />
        </div>

        <!-- Programming -->
        <div class="Fade_Up flex_center flex-col gap-4 py-6 px-6 w-full h-full min-h-[280px] rounded-2xl bg-[var(--cardGlass)] border border-[var(--borderColor)] backdrop-blur-sm hover:border-[var(--borderHover)] transition-all duration-300">
            <SkillTitle title="Programming" color="primary" />
            <SkillGrid stack={ProgrammingStack} />
        </div>

        <!-- Tech & Tools -->
        <div class="Fade_Up flex_center flex-col gap-4 py-6 px-6 w-full h-full min-h-[280px] rounded-2xl bg-[var(--cardGlass)] border border-[var(--borderColor)] backdrop-blur-sm hover:border-[var(--borderHover)] transition-all duration-300">
            <SkillTitle title="Tech & Tools" color="primary" />
            <SkillGrid stack={ToolsStack} />
        </div>
    </div>
</section>

---
import { CenterTitle } from "./UI";
import { Mail, MapPin, Clock, Send } from "lucide-preact";
---

<section
    id="contact"
    class="w-full min-h-screen mb-16 lg:mb-[5em] px-6 py-16 pt-14 bg-background relative overflow-hidden"
>
    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[var(--primaryColor)] opacity-[0.05] rounded-full blur-[150px]"></div>
        <div class="absolute top-0 left-0 w-96 h-96 bg-[var(--primaryColor)] opacity-[0.03] rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 right-0 w-96 h-96 bg-[var(--secondaryColor)] opacity-[0.03] rounded-full blur-[100px]"></div>
    </div>

    <CenterTitle title="Get In Touch" color="primary" />

    <div class="w-full flex_center flex-col p-4 text-[1.2em] text-center mb-10 relative z-10">
        <h3
            class="Fade_Up gradientText font-ubuntu text-[2.5rem] lg:text-[3.5rem] font-bold"
        >
            Let's Work Together
        </h3>
        <p class="Fade_Up text-[var(--textDim)] mt-4 max-w-2xl leading-relaxed">
            I'm currently available for freelance work and full-time opportunities. 
            If you have a project that needs some creative touch or want to collaborate, 
            feel free to reach out!
        </p>
        
        <a 
            href="mailto:m.hossam1050@nub.edu.eg"
            class="Fade_Up mt-8 inline-flex items-center gap-3 px-8 py-4 bg-[var(--gradient)] rounded-full font-semibold text-lg hover:scale-105 transition-transform duration-300"
        >
            <Send size={20} />
            Say Hello
        </a>
    </div>

    <div class="w-full max-w-5xl mx-auto flex flex-col gap-10 px-4 lg:px-10 pb-20 relative z-10">
        <!-- Contact Info -->
        <div class="flex flex-col gap-8 Fade_Up">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Email Card -->
                <a href="mailto:m.hossam1050@nub.edu.eg" class="group">
                    <div class="p-6 rounded-2xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] hover:border-[var(--primaryColor)] transition-all duration-300 flex flex-col items-center gap-4 h-full">
                        <div class="w-14 h-14 rounded-full bg-[var(--primaryLite)] flex_center text-[var(--primaryColor)] group-hover:scale-110 transition-transform duration-300">
                            <Mail size={24} />
                        </div>
                        <div class="flex flex-col items-center text-center">
                            <span class="text-[var(--textDim)] text-sm uppercase tracking-wider mb-1">Email</span>
                            <span class="text-[var(--text)] font-medium group-hover:text-[var(--primaryColor)] transition-colors break-all text-sm">m.hossam1050@nub.edu.eg</span>
                        </div>
                    </div>
                </a>

                <!-- Location Card -->
                <div class="p-6 rounded-2xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex flex-col items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-[var(--primaryLite)] flex_center text-[var(--primaryColor)]">
                        <MapPin size={24} />
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-[var(--textDim)] text-sm uppercase tracking-wider mb-1">Location</span>
                        <span class="text-[var(--text)] font-medium">Cairo, Egypt</span>
                    </div>
                </div>

                <!-- Availability Card -->
                <div class="p-6 rounded-2xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex flex-col items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-[var(--primaryLite)] flex_center text-[var(--primaryColor)]">
                        <Clock size={24} />
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-[var(--textDim)] text-sm uppercase tracking-wider mb-1">Availability</span>
                        <span class="text-[var(--text)] font-medium">Freelance & Full-time</span>
                    </div>
                </div>
            </div>

            <!-- Social Links -->
            <div class="flex flex-col gap-6 mt-4 items-center">
                <span class="text-[var(--textDim)] text-lg font-medium">Connect with me</span>
                <div class="flex gap-4">
                    <a href="https://github.com/mo-hossam-stack" target="_blank" rel="noreferrer" aria-label="GitHub" class="w-12 h-12 rounded-xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex_center text-[var(--text)] hover:border-[var(--primaryColor)] hover:text-[var(--primaryColor)] hover:-translate-y-1 transition-all duration-300">
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/in/mohamed-hossam-dev/" target="_blank" rel="noreferrer" aria-label="LinkedIn" class="w-12 h-12 rounded-xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex_center text-[var(--text)] hover:border-[#0077b5] hover:text-[#0077b5] hover:-translate-y-1 transition-all duration-300">
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"></path>
                        </svg>
                    </a>
                    <a href="https://www.facebook.com/mhmd.hsam.437997" target="_blank" rel="noreferrer" aria-label="Facebook" class="w-12 h-12 rounded-xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex_center text-[var(--text)] hover:border-[#1877f2] hover:text-[#1877f2] hover:-translate-y-1 transition-all duration-300">
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"></path>
                        </svg>
                    </a>
                    <a href="https://leetcode.com/u/MOHAMEDHOSSAM2112/" target="_blank" rel="noreferrer" aria-label="LeetCode" class="w-12 h-12 rounded-xl bg-[var(--surfaceElevated)] border border-[var(--borderColor)] flex_center text-[var(--text)] hover:border-[#ffa116] hover:text-[#ffa116] hover:-translate-y-1 transition-all duration-300">
                        <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.3 5.3 0 0 0-.125.513 5.507 5.507 0 0 0 .062 2.362 5.832 5.832 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

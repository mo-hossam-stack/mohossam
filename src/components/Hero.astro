---
import { Image } from "astro:assets";
import Avatar_180 from "../assets/Mohamed.jpg";
import Avatar_250 from "../assets/Mohamed.jpg";
---

<section
    id="Hero"
    class="w-full h-[calc(100vh-4rem)] px-6 py-4 bg-background flex justify-evenly lg:justify-around items-center flex-col-reverse lg:flex-row overflow-hidden"
>
    <!-- Hero Intro Info -->
    <div class="w-full lg:w-fit flex justify-start items-center flex-col gap-8">
        <div class="text-[18px] lg:text-[26px] text-center lg:text-left">
            <p class="Fade_Stagger">Hi! my name is,</p>
            <h1
                class="Fade_Stagger gradientText font-ubuntu text-[4em] lg:text-[9rem] leading-tight"
            >
                Mohamed.
            </h1>
            <p class="Fade_Stagger">I'm a Computer Science Student & Backend Developer.</p>
            <p class="Fade_Stagger">
                I create
                <span class="gradientText font-ubuntu">Scalable Systems</span>
                on the Internet.
            </p>
        </div>

        <div
            class="Fade_Stagger flex justify-center lg:justify-start items-center w-full gap-10 py-4"
        >
            <a
                href="https://github.com/mo-hossam-stack"
                title="GitHub"
                target="_blank"
                rel="author"
                aria-label="GitHub"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 16 16"
                    color="#fff"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="https://www.linkedin.com/in/mohamed-hossam-dev/"
                title="LinkedIn"
                target="_blank"
                rel="noreferrer"
                aria-label="LinkedIn"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 16 16"
                    color="var(--text)"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="https://www.facebook.com/mhmd.hsam.437997"
                title="Facebook"
                target="_blank"
                rel="noreferrer"
                aria-label="Facebook"
                class="Fade_Stagger"
            >
               <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 16 16"
                    color="#fff"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="mailto:m.hossam1050@nub.edu.eg"
                title="Email"
                target="_blank"
                rel="noreferrer"
                aria-label="Email"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 24 24"
                    color="#fff"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="https://codeforces.com/profile/MOHAMEDHOSSAM34"
                title="Codeforces"
                target="_blank"
                rel="noreferrer"
                aria-label="Codeforces"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 24 24"
                    color="#fff"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.672 21 0 20.328 0 19.5V9c0-.828.672-1.5 1.5-1.5h3zm9-4.5c.828 0 1.5.672 1.5 1.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V4.5c0-.828.672-1.5 1.5-1.5h3zm9 7.5c.828 0 1.5.672 1.5 1.5v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5v-7.5c0-.828.672-1.5 1.5-1.5h3z"
                    >
                    </path>
                </svg>
            </a>
            <a
                href="https://leetcode.com/u/MOHAMEDHOSSAM2112/"
                title="LeetCode"
                target="_blank"
                rel="noreferrer"
                aria-label="LeetCode"
                class="Fade_Stagger"
            >
                <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 24 24"
                    color="#fff"
                    height="30"
                    width="30"
                    xmlns="http://www.w3.org/2000/svg"
                    style="color: var(--heroSocialColor);"
                >
                    <path
                        d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.3 5.3 0 0 0-.125.513 5.507 5.507 0 0 0 .062 2.362 5.832 5.832 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"
                    >
                    </path>
                </svg>
            </a>
        </div>
    </div>

    <!-- Hero Orbit Animation -->
    <div
        class="Hero_Orbit relative flex_center w-[360px] lg:w-[500px] aspect-square"
    >
        <div
            class="Spring_Up flex_center w-[50%] aspect-square rounded-full z-10"
        >
            <Image
                src={Avatar_180}
                alt="Hero_Avatar"
                class="object-cover w-full h-full rounded-full"
                width="250"
                height="250"
                loading="eager"
            />
        </div>
        <div class="Spring_Up Hero_Trail Trail1">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail2">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail3">
            <span class="Orbit_Dot"></span>
        </div>
        <div class="Spring_Up Hero_Trail Trail4">
            <span class="Orbit_Dot"></span>
        </div>
    </div>
</section>

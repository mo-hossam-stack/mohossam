---
import { SEO } from "astro-seo";
import { AstroFont } from "astro-font";
import { join } from "node:path";
import { Header, MobileHeader, Cursor } from "../components/UI";
import { Footer } from "../components";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000" />
		<meta name="robots" content="index, follow" />
		<!-- <meta
			name="google-site-verification"
			content="YRAUUyc8TP4QJ1s53KAdLxcON9xifQf33BnLeP-F_5Y"
		/> -->
		<meta
			name="keywords"
			content="Mohamed Hossam, portfolio, backend developer, computer science, full stack, web developer"
		/>
		<meta
			name="description"
			content="Mohamed Hossam | Computer Science Student & Backend Developer"
		/>
		<meta name="author" content="Mohamed Hossam" />
		<title>Mohamed Hossam</title>
		<link rel="manifest" href="/manifest.json" />

		<!-- Preload CSS Styles -->
		<link rel="preload stylesheet" href="/styles/global.css" as="style" />
		<link rel="preload stylesheet" href="/styles/utility.css" as="style" />
		<link rel="preload stylesheet" href="/styles/cursor.css" as="style" />

		<SEO
			title="Mohamed Hossam"
			description="Backend Developer | Django & FastAPI | Open Source & Competitive Programming"
			canonical="https://mohossam.netlify.app/"
			openGraph={{
				basic: {
					title: "Mohamed Hossam",
					type: "website",
					image: "https://mohossam.netlify.app/assets/profile.jpg",
					url: "https://mohossam.netlify.app/",
				},
			}}
			twitter={{
				title: "Mohamed Hossam",
				description:
					"Backend Developer | FastAPI & Django | Open Source & Competitive Programming",
				card: "summary_large_image",
				image: "https://mohossam.netlify.app/assets/profile.jpg",
			}}
			extend={{
				link: [
					{ rel: "icon", type: "image/png", href: "/favicon.png" },
					{
						rel: "shortcut",
						type: "image/png",
						href: "/favicon.png",
					},
					{
						rel: "apple-touch-icon",
						type: "image/png",
						href: "/favicon.png",
					},
				],
				meta: [
					{
						name: "twitter:url",
						content: "https://mohossam.netlify.app/",
					},
					{
						name: "twitter:image:alt",
						content: "Mohamed Hossam - Backend Developer",
					},
				],
			}}
		/>

		<AstroFont
			config={[
				{
					name: "Poppins",
					src: [
						{
							weight: "400",
							style: "normal",
							path: join(
								process.cwd(),
								"public",
								"fonts",
								"poppins-v20-latin-regular.woff2",
							),
						},
					],
					preload: true,
					display: "swap",
					fallback: "serif",
					cssVariable: "astro-font-poppins",
				},
				{
					name: "Satisfy",
					src: [
						{
							weight: "400",
							style: "normal",
							path: join(
								process.cwd(),
								"public",
								"fonts",
								"satisfy-v17-latin-regular.woff2",
							),
						},
					],
					preload: true,
					display: "swap",
					fallback: "serif",
					cssVariable: "astro-font-satisfy",
				},
				{
					name: "Ubuntu",
					src: [
						{
							weight: "700",
							style: "normal",
							path: join(
								process.cwd(),
								"public",
								"fonts",
								"ubuntu-v20-latin-700.woff2",
							),
						},
					],
					preload: true,
					display: "swap",
					fallback: "serif",
					cssVariable: "astro-font-ubuntu",
				},
			]}
		/>

		<style is:global>
			:root {
				/* Sophisticated Dark Theme - Professional Developer Portfolio */
				--base: #0a0a0f;
				--baseLite: rgba(10, 10, 15, 0.95);
				--surface: #12121a;
				--surfaceElevated: #1a1a25;
				--text: #f0f0f5;
				--textMuted: #a0a0b0;
				--textDim: #606070;

				/* Accent Colors - Modern Teal/Cyan Palette */
				--primary: 170, 85%, 45%;
				--primaryHue: 170;
				--primarySat: 85%;
				--primaryLit: 45%;
				
				--secondary: 260, 70%, 60%;
				--secondaryHue: 260;
				--secondarySat: 70%;
				--secondaryLit: 60%;
				
				/* Derived Colors */
				--primaryColor: hsl(var(--primary));
				--secondaryColor: hsl(var(--secondary));
				--primaryLite: hsla(var(--primary), 0.15);
				--primaryLiteAlt: hsla(var(--primary), 0.08);
				--secondaryLite: hsla(var(--secondary), 0.15);
				--secondaryLiteAlt: hsla(var(--secondary), 0.08);

				/* Gradients */
				--gradient: linear-gradient(
					135deg,
					hsl(var(--primaryHue), var(--primarySat), var(--primaryLit)),
					hsl(var(--secondaryHue), var(--secondarySat), var(--secondaryLit))
				);
				--gradientSubtle: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--gradientGlow: radial-gradient(
					ellipse at center,
					hsla(var(--primary), 0.12) 0%,
					transparent 70%
				);

				/* Card & Surface Styles */
				--headerGradient: linear-gradient(
					180deg,
					rgba(10, 10, 15, 0.95),
					rgba(10, 10, 15, 0.7)
				);
				--cardGradient: linear-gradient(
					145deg,
					var(--surfaceElevated),
					var(--surface)
				);
				--cardGlass: linear-gradient(
					135deg,
					rgba(255, 255, 255, 0.05),
					rgba(255, 255, 255, 0.02)
				);
				--overlayGradient: radial-gradient(
					farthest-corner at 100% 0%,
					hsla(var(--primary), 0.08),
					transparent 50%
				);
				--LinkBtnGradient: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--SkillGradient: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--SkillGradientAlt: linear-gradient(
					135deg,
					var(--primaryLiteAlt),
					var(--secondaryLiteAlt)
				);

				/* Border Colors */
				--borderColor: rgba(255, 255, 255, 0.06);
				--borderHover: rgba(255, 255, 255, 0.12);

				/* Special Effects */
				--orbitDotColor: hsl(var(--primaryHue), var(--primarySat), var(--primaryLit));
				--heroSocialColor: #ffffff;
				--contactSocialColor: rgba(255, 255, 255, 0.6);
				--cursorColor: hsla(var(--primary), 0.5);
				--cursorColorAlt: hsla(var(--primary), 0.7);
				--dotColor: hsl(var(--primaryHue), var(--primarySat), var(--primaryLit));
				--glowPrimary: 0 0 30px hsla(var(--primary), 0.3);
				--glowSecondary: 0 0 30px hsla(var(--secondary), 0.3);
			}

			html.light {
				--base: #fafafa;
				--baseLite: rgba(250, 250, 250, 0.95);
				--surface: #ffffff;
				--surfaceElevated: #f5f5f8;
				--text: #1a1a1f;
				--textMuted: #606070;
				--textDim: #a0a0a5;

				--primary: 170, 85%, 35%;
				--secondary: 260, 70%, 50%;

				--primaryColor: hsl(var(--primary));
				--secondaryColor: hsl(var(--secondary));
				--primaryLite: hsla(var(--primary), 0.1);
				--primaryLiteAlt: hsla(var(--primary), 0.05);
				--secondaryLite: hsla(var(--secondary), 0.1);
				--secondaryLiteAlt: hsla(var(--secondary), 0.05);

				--gradient: linear-gradient(
					135deg,
					hsl(var(--primary)),
					hsl(var(--secondary))
				);
				--gradientSubtle: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--gradientGlow: radial-gradient(
					ellipse at center,
					hsla(var(--primary), 0.08) 0%,
					transparent 70%
				);

				--headerGradient: linear-gradient(
					180deg,
					rgba(250, 250, 250, 0.95),
					rgba(250, 250, 250, 0.8)
				);
				--cardGradient: linear-gradient(
					145deg,
					#ffffff,
					#f5f5f8
				);
				--cardGlass: linear-gradient(
					135deg,
					rgba(255, 255, 255, 0.8),
					rgba(255, 255, 255, 0.6)
				);
				--overlayGradient: radial-gradient(
					farthest-corner at 100% 0%,
					hsla(var(--primary), 0.05),
					transparent 50%
				);
				--LinkBtnGradient: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--SkillGradient: linear-gradient(
					135deg,
					var(--primaryLite),
					var(--secondaryLite)
				);
				--SkillGradientAlt: linear-gradient(
					135deg,
					var(--primaryLiteAlt),
					var(--secondaryLiteAlt)
				);

				--borderColor: rgba(0, 0, 0, 0.06);
				--borderHover: rgba(0, 0, 0, 0.12);

				--orbitDotColor: hsl(var(--primary));
				--heroSocialColor: #1a1a1f;
				--contactSocialColor: rgba(0, 0, 0, 0.5);
				--cursorColor: hsla(var(--primary), 0.4);
				--cursorColorAlt: hsla(var(--primary), 0.6);
				--dotColor: hsl(var(--primary));
				--glowPrimary: 0 0 20px hsla(var(--primary), 0.2);
				--glowSecondary: 0 0 20px hsla(var(--secondary), 0.2);
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-family: Poppins, system-ui, sans-serif;
				scroll-behavior: smooth;
			}

			body {
				background-color: var(--base);
				color: var(--text);
				overflow-x: hidden;
			}

			::selection {
				background: var(--primaryColor);
				color: var(--base);
			}

			/* Header */
			.Header_Nav a {
				position: relative;
				overflow: hidden;
				letter-spacing: 0.5px;
				font-weight: 500;
				transition: color 0.3s ease;
			}

			.Header_Nav a:hover {
				color: var(--primaryColor);
			}

			.Header_Nav a::after {
				content: "";
				position: absolute;
				bottom: -2px;
				left: 0;
				width: 100%;
				height: 2px;
				background: var(--primaryColor);
				transform: scaleX(0);
				transition: transform 0.3s ease;
			}

			.Header_Nav a.active::after {
				transform: scaleX(1);
			}

			.Header_Nav a.active {
				color: var(--primaryColor);
			}

			/* Action Button Style - Modern Gradient */
			.Header_ActionBtn {
				position: relative;
				border-radius: 8px;
				overflow: hidden;
				display: grid;
				place-items: center;
				background: var(--gradient);
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}

			.Header_ActionBtn:hover {
				transform: translateY(-2px);
				box-shadow: var(--glowPrimary);
			}

			.Header_ActionBtn > div {
				padding: 0.5em 1.5em;
				background: transparent;
				color: var(--text);
				border-radius: inherit;
				margin: 2px;
				z-index: 2;
			}

			/* Mobile Header Nav */
			.MobileHeader_Nav {
				min-width: 14em;
				text-align: center;
				background: var(--cardGradient);
				border-radius: 12px;
				padding: 1em;
				font-size: 1.3em;
				font-weight: 600;
				letter-spacing: 0.5px;
				border: 1px solid var(--borderColor);
			}

			.MobileHeader_Nav a {
				width: 100%;
				color: var(--text);
				text-decoration: none;
				text-transform: uppercase;
				transition: color 0.3s ease;
			}

			.MobileHeader_Nav a:hover,
			.MobileHeader_Nav a.active {
				color: var(--primaryColor);
			}

			.MobileHeader_Nav a.active {
				background: var(--gradient);
				background-clip: text;
				-webkit-background-clip: text;
				color: transparent;
				background-size: 200%;
				animation: gradientPan 5s linear infinite;
			}

			:has(.MobileHeader_ActionBtn).MobileHeader_Nav {
				padding: 0;
			}

			.MobileHeader_ActionBtn {
				position: relative;
				border-radius: 8px;
				overflow: hidden;
				background: var(--gradient);
			}

			.MobileHeader_ActionBtn > div {
				padding: 0.7em 1em;
				width: 100%;
				background: transparent;
				color: var(--text);
				border-radius: inherit;
				margin: 4px;
				z-index: 2;
			}

			/* Page Title Style */
			.Title-Tag {
				font-family: Ubuntu;
			}

			.Title-Tag span,
			.Title-Tag p {
				z-index: 1;
				background-color: var(--base);
				padding-inline: 0.25em;
			}

			.Title-Tag.open {
				margin-bottom: 1em;
				justify-content: flex-start;
			}

			.Title-Tag.close {
				justify-content: flex-end;
				padding-top: 0.5em;
				opacity: 0.7 !important;
			}

			.Title-Tag.primary span {
				color: hsl(var(--primary));
			}

			.Title-Tag.secondary span {
				color: hsl(var(--secondary));
			}

			.Title_Line::after {
				content: "";
				position: absolute;
				margin-top: 0.3em;
				width: 100%;
				height: 2px;
				z-index: 0;
				background-color: var(--primaryLite);
			}

			.Title_Line.secondary::after {
				background-color: var(--secondaryLite);
			}

			.Title_Line.close::after {
				background-color: transparent;
			}

			/* Mobile Ham Menu Animation --> */
			.MobileNav_Ham {
				-webkit-tap-highlight-color: transparent;
				transition: transform 0.4s;
				user-select: none;
			}

			.MobileNav_Ham .line {
				fill: none;
				transition:
					stroke-dasharray 0.4s,
					stroke-dashoffset 0.4s;
				stroke: var(--text);
				stroke-width: 5.5;
				transform-origin: right;
				stroke-linecap: round;
			}

			html.light .MobileNav_Ham .line {
				stroke: hsl(var(--primary)) !important;
			}

			.MobileNav_Ham .top {
				stroke-dasharray: 18 160;
			}

			.MobileNav_Ham .middle {
				stroke-dasharray: 40 142;
				transform-origin: 83% 83%;
				transition: transform 0.4s;
			}

			.MobileNav_Ham .bottom {
				stroke-dasharray: 18 85;
				transform-origin: 50%;
				transition:
					transform 0.4s,
					stroke-dashoffset 0.4s;
			}

			.Projects_Link {
				padding: 0.5em;
				border: 1px solid var(--borderHover);
				border-radius: 50%;
				z-index: 10;
				transition: all 0.3s ease;
				color: var(--text);
			}

			.Projects_Link:hover {
				background: var(--primaryColor);
				border-color: var(--primaryColor);
				color: var(--base);
				transform: scale(1.1);
			}

			/* Cursor */
			.Cursor-Main {
				position: absolute;
				width: 100%;
				height: 100%;
				inset: 0;
				z-index: 9999;
				overflow: hidden;
				pointer-events: none;
			}

			/* Hero */
			.Hero_Trail {
				position: absolute;
				aspect-ratio: 1;
				border-radius: 50%;
				animation: spin 20s linear infinite;
				animation-delay: 1s;
				border: 1px solid transparent;
			}

			.Hero_Trail::before {
				content: "";
				width: calc(100% - 2px);
				aspect-ratio: 1;
				inset: 0;
				margin: auto;
				border-radius: 50%;
				position: absolute;
				background-color: var(--base);
			}

			.Trail1 {
				width: 60%;
				background: conic-gradient(
					from 0deg,
					transparent,
					hsla(var(--primary), 0.3),
					hsla(var(--primary), 0.5),
					transparent
				);
				z-index: 5;
			}

			.Trail2 {
				width: 70%;
				animation-duration: 25s;
				animation-direction: reverse;
				background: conic-gradient(
					from 180deg,
					transparent,
					hsla(var(--secondary), 0.3),
					hsla(var(--secondary), 0.5),
					transparent
				);
				z-index: 4;
			}

			.Trail3 {
				width: 80%;
				background: conic-gradient(
					from 90deg,
					transparent,
					hsla(var(--primary), 0.2),
					hsla(var(--secondary), 0.2),
					transparent
				);
				animation-duration: 30s;
				z-index: 3;
			}

			.Trail4 {
				width: 90%;
				animation-duration: 35s;
				animation-direction: reverse;
				background: conic-gradient(
					from 270deg,
					transparent,
					hsla(var(--primary), 0.15),
					hsla(var(--secondary), 0.15),
					transparent
				);
				z-index: 2;
			}

			.Trail2 span,
			.Trail4 span {
				transform: rotate(140deg) !important;
			}

			footer {
				color: var(--text) !important;
			}

			/* Lenis Smooth Scroll */
			html.lenis {
				height: auto;
			}

			.lenis.lenis-smooth {
				scroll-behavior: auto !important;
			}

			.lenis.lenis-smooth [data-lenis-prevent] {
				overscroll-behavior: contain;
			}

			.lenis.lenis-stopped {
				overflow: hidden;
			}

			.lenis.lenis-scrolling iframe {
				pointer-events: none;
			}

			/* GSAP Animation inits */
			.flex_center {
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.gradientText {
				background: var(--gradient);
				background-clip: text;
				-webkit-background-clip: text;
				color: transparent;
				background-size: 200%;
				animation: gradientPan 8s linear infinite;
				will-change: background-position;
			}

			.Orbit_Dot {
				width: 0.6em;
				aspect-ratio: 1;
				background-color: var(--orbitDotColor);
				border-radius: 50%;
				position: absolute;
				top: -0.25em;
				left: 49%;
				transition: 0.3s ease;
				overflow: hidden;
				box-shadow: 0 0 15px var(--orbitDotColor), 0 0 30px var(--orbitDotColor);
			}

			:has(.Hero_Orbit:hover) .Orbit_Dot {
				background-color: var(--base) !important;
				outline: 1px solid var(--orbitDotColor);
				scale: 2;
			}

			.Fade_Stagger,
			.Fade_Up {
				opacity: 0;
				transform: translateY(30px);
			}

			.Fade_Down {
				opacity: 0;
				transform: translateY(-30px);
			}

			.Fade_In {
				opacity: 0;
			}

			.Spring_Up {
				opacity: 0;
				scale: 0.8;
			}

			/* Card hover effects */
			.Card_Main {
				transition: transform 0.4s ease, box-shadow 0.4s ease;
			}

			.Card_Main:hover {
				transform: translateY(-8px);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), var(--glowPrimary);
			}

			.Card_Image {
				transition: transform 0.5s ease, opacity 0.3s ease;
			}

			.Card_Main:hover .Card_Image {
				transform: scale(1.05);
				opacity: 0.7;
			}

			@keyframes spin {
				0% {
					rotate: 0deg;
				}

				100% {
					rotate: 360deg;
				}
			}
		</style>
	</head>
	<body id="home">
		<Header />
		<MobileHeader />

		<main>
			<slot />
		</main>

		<Footer />
		<Cursor />
		<script src="../script.ts"></script>
	</body>
</html>
